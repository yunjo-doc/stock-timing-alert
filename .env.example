# 이 파일을 복사해서 .env 로 이름을 바꾸고 실제 값을 채운 뒤 로컬 테스트하세요.
# 실제 .env 파일은 .gitignore 에 의해 GitHub에 올라가지 않습니다.

# 관리자 전용 API(POST /run-now) 호출 시 필요한 임의의 비밀 문자열 (직접 정하세요)
ADMIN_TOKEN=change-me-to-a-random-string

# 로그인 세션 암호화에 쓰이는 임의의 긴 문자열 (직접 정하세요, 절대 공개하지 마세요)
SESSION_SECRET=change-me-to-a-long-random-string

# 카카오톡 알림 (REST API 키만 채우면, 이후 각 사용자가 /account 에서 직접 연동합니다)
KAKAO_REST_API_KEY=

# Toss Payments 정기결제(빌링) 연동 — https://developers.tosspayments.com 에서 발급
# 테스트 키는 가입 즉시 대시보드에서 바로 확인 가능합니다 (사업자 등록 없이도 테스트 가능)
# CLIENT_KEY는 프론트엔드에 노출되는 공개키, SECRET_KEY는 절대 공개하면 안 되는 비밀키입니다.
TOSS_CLIENT_KEY=test_ck_...
TOSS_SECRET_KEY=test_sk_...

# 카카오페이 정기결제 연동 — https://developers.kakaopay.com 에서 애플리케이션 등록 후 발급
# 정기결제용 CID는 별도로 신청/발급받아야 합니다(테스트는 "TCSUBSCRIP" 사용 가능).
# 운영 환경은 KAKAO_PAY_SECRET_KEY, 개발/테스트 환경은 KAKAO_PAY_DEV_SECRET_KEY를 사용합니다.
KAKAO_PAY_CID=TCSUBSCRIP
KAKAO_PAY_SECRET_KEY=
KAKAO_PAY_DEV_SECRET_KEY=

# PayApp(페이앱) 정기결제 연동 — 판매자 회원가입 후 "설정 > 연동 정보"에서 확인
# linkkey/linkval은 정기결제 해지 등 관리 API 호출과 feedbackurl 검증에 사용됩니다.
PAYAPP_USERID=
PAYAPP_LINKKEY=
PAYAPP_LINKVAL=

# (선택) Render Persistent Disk 등 별도 디스크에 DB 파일을 저장하고 싶을 때만 설정.
# 로컬 개발 시에는 비워두면 프로젝트 폴더 안의 data/ 를 그대로 사용합니다.
# Render 배포 시에는 Persistent Disk의 마운트 경로(예: /var/data)를 넣어야
# 재배포/슬립 때마다 회원 데이터가 초기화되지 않습니다. README의
# "데이터 영구 보존(Persistent Disk)" 섹션을 참고하세요.
DATA_DIR=
