# 이 파일을 복사해서 .env 로 이름을 바꾸고 실제 값을 채운 뒤 로컬 테스트하세요.
# 실제 .env 파일은 .gitignore 에 의해 GitHub에 올라가지 않습니다.

# 관리자 전용 API(POST /run-now) 호출 시 필요한 임의의 비밀 문자열 (직접 정하세요)
ADMIN_TOKEN=change-me-to-a-random-string

# 로그인 세션 암호화에 쓰이는 임의의 긴 문자열 (직접 정하세요, 절대 공개하지 마세요)
SESSION_SECRET=change-me-to-a-long-random-string

# 카카오톡 알림 (REST API 키만 채우면, 이후 각 사용자가 /account 에서 직접 연동합니다)
KAKAO_REST_API_KEY=

# Toss Payments 정기결제(빌링) 연동 — https://developers.tosspayments.com 에서 발급
# 테스트 키는 가입 즉시 대시보드에서 바로 확인 가능합니다 (사업자 등록 없이도 테스트 가능)
# CLIENT_KEY는 프론트엔드에 노출되는 공개키, SECRET_KEY는 절대 공개하면 안 되는 비밀키입니다.
TOSS_CLIENT_KEY=test_ck_...
TOSS_SECRET_KEY=test_sk_...
